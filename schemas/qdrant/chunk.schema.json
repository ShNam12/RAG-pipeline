{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Section chunk payload for Qdrant",
  "description": "One hierarchy node that may cover multiple OCR regions and pages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "source", "source_id", "ocr_path", "ocr_sha256", "ocr_model", "ocr_status", "embedding_model", "section_id", "section_heading", "level", "parent_id", "text", "page_numbers", "region_ids", "tables"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "record_type": {"const": "chunk"},
    "source": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "format": "uuid"},
    "ocr_path": {"type": "string", "minLength": 1},
    "ocr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ocr_model": {"type": "string", "minLength": 1},
    "ocr_status": {"enum": ["complete", "partial", "failed"]},
    "embedding_model": {"const": "thanhtantran/Vietnamese_Embedding"},
    "section_id": {"type": "string", "format": "uuid"},
    "section_heading": {"type": ["string", "null"]},
    "level": {"enum": [0, 1, 2]},
    "parent_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "uuid"}
      ]
    },
    "text": {"type": "string", "minLength": 1},
    "page_numbers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "region_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "table"],
        "properties": {
          "region_id": {"type": "string", "minLength": 1},
          "table": {"$ref": "table.schema.json"}
        }
      }
    },
    "embedding_text": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"level": {"const": 0}}},
      "then": {
        "properties": {"parent_id": {"type": "null"}},
        "not": {"required": ["embedding_text"]}
      }
    },
    {
      "if": {"properties": {"level": {"enum": [1, 2]}}},
      "then": {"properties": {"parent_id": {"type": "string", "format": "uuid"}}}
    },
    {
      "if": {"properties": {"level": {"const": 1}}},
      "then": {"not": {"required": ["embedding_text"]}}
    },
    {
      "if": {"properties": {"level": {"const": 2}}},
      "then": {"required": ["embedding_text"]}
    }
  ]
}
