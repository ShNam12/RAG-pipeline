{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target dense and sparse searchable Qdrant point",
  "description": "Target hybrid point for a text child or header-keyed table row. These vectors are not produced by the current indexer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "vector", "payload"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "lexical"],
      "properties": {
        "text": {"$ref": "point.schema.json#/$defs/chunk_vector"},
        "lexical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indices", "values"],
          "properties": {
            "indices": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0}
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number"}
            }
          }
        }
      }
    },
    "payload": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "chunk.schema.json"},
            {"properties": {"level": {"const": 2}}}
          ]
        },
        {"$ref": "table-row.schema.json"}
      ]
    }
  }
}
