{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rag1 extraction payload for Qdrant",
  "description": "One text scope or table proposal with source evidence and optional nested table data.",
  "$comment": "Validate geometry bounds, page-number agreement, source references, and text/evidence agreement in the ingestion consumer as well as applying this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "record_type", "source", "page_number", "dpi", "proposal", "text", "text_source", "provenance", "artifacts", "evidence", "table", "needs_review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "format": "uuid"},
    "record_type": {"enum": ["text", "table"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "format": {"enum": ["pdf", "docx", "image"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "page_number": {"type": "integer", "minimum": 1},
    "dpi": {"type": ["integer", "null"], "minimum": 1},
    "proposal": {"$ref": "#/$defs/proposal"},
    "text": {
      "description": "Embedding input from the declared text_source, with raw table OCR treated as evidence awaiting row and column reconstruction.",
      "type": "string"
    },
    "text_source": {"enum": ["ocr_region", "associated_lines", "table_structure"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "ocr", "association"],
      "properties": {
        "layout": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "manifest_path", "schema_version", "status", "proposal_pointer"],
              "properties": {
                "path": {"$ref": "#/$defs/repository_path"},
                "manifest_path": {"$ref": "#/$defs/repository_path"},
                "schema_version": {"type": "string", "minLength": 1},
                "status": {"$ref": "#/$defs/document_status"},
                "proposal_pointer": {"type": ["string", "null"], "pattern": "^/regions/[0-9]+$"}
              }
            }
          ]
        },
        "ocr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "schema_version", "status", "input_mode", "model", "region_id", "region_pointer"],
          "properties": {
            "path": {"$ref": "#/$defs/repository_path"},
            "schema_version": {"type": "string", "minLength": 1},
            "status": {"$ref": "#/$defs/document_status"},
            "input_mode": {"enum": ["layout", "direct"]},
            "model": {"type": "string", "minLength": 1},
            "region_id": {"type": "string", "minLength": 1},
            "region_pointer": {"type": "string", "pattern": "^/regions/[0-9]+$"}
          }
        },
        "association": {
          "description": "ocr_scope preserves a full OCR proposal; line_center_in_layout_bbox selects same-page OCR lines by their page-quad bounding-box center as an unreviewed spatial association.",
          "enum": ["ocr_scope", "layout_proposal_id", "line_center_in_layout_bbox"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_image", "region_crop"],
      "properties": {
        "page_image": {"$ref": "#/$defs/repository_path"},
        "region_crop": {
          "description": "Saved image for the selected proposal only, or null when its crop has not been extracted.",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/repository_path"}]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocr_region_status", "ocr_crop", "lines", "blocks"],
      "properties": {
        "ocr_region_status": {"enum": ["complete", "empty", "partial", "failed", "skipped"]},
        "ocr_crop": {"$ref": "#/$defs/ocr_crop"},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/ocr_line"}},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/ocr_block"}}
      }
    },
    "table": {
      "oneOf": [{"type": "null"}, {"$ref": "table.schema.json"}]
    },
    "needs_review": {
      "description": "Processing status does not establish OCR quality or table association accuracy.",
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "text"}}},
      "then": {
        "properties": {
          "proposal": {"properties": {"kind": {"const": "text"}}},
          "table": {"type": "null"},
          "text_source": {"const": "ocr_region"}
        }
      },
      "else": {
        "properties": {
          "proposal": {"properties": {"kind": {"const": "table"}}},
          "table": {"$ref": "table.schema.json"},
          "text_source": {"enum": ["associated_lines", "table_structure"]}
        }
      }
    },
    {
      "if": {"properties": {"text_source": {"const": "table_structure"}}},
      "then": {
        "properties": {
          "table": {"properties": {"structure_status": {"enum": ["complete", "partial"]}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {"properties": {"association": {"enum": ["layout_proposal_id", "line_center_in_layout_bbox"]}}}
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "layout": {
                "type": "object",
                "properties": {"proposal_pointer": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repository_path": {
      "description": "Repository-relative POSIX path, except that raw OCR crop paths inside evidence remain relative to the referenced OCR JSON directory.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "document_status": {"enum": ["complete", "partial", "failed"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "bbox": {"$ref": "table.schema.json#/$defs/bbox"},
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "minimum": 0}
    },
    "quad": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/point"}
    },
    "proposal": {
      "description": "Original layout proposal or direct-mode OCR proposal, unchanged.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "raw_label", "confidence", "location"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["text", "table"]},
        "role": {"enum": ["body", "title", "header", "footer", "page_number"]},
        "raw_label": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "#/$defs/confidence"},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "page_number", "bbox", "page_width", "page_height", "coordinate_origin"],
          "properties": {
            "type": {"const": "visual"},
            "page_number": {"type": "integer", "minimum": 1},
            "bbox": {"$ref": "#/$defs/bbox"},
            "page_width": {"type": "number", "exclusiveMinimum": 0},
            "page_height": {"type": "number", "exclusiveMinimum": 0},
            "coordinate_origin": {"const": "top_left"}
          }
        }
      }
    },
    "ocr_crop": {
      "description": "Original OCR scope crop, which may be a full-page crop even when the selected layout proposal is a table.",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_bbox", "page_bbox", "page_origin", "width", "height", "path"],
      "properties": {
        "proposal_bbox": {"$ref": "#/$defs/bbox"},
        "page_bbox": {"$ref": "#/$defs/bbox"},
        "page_origin": {"$ref": "#/$defs/point"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/repository_path"}]}
      }
    },
    "ocr_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region_id", "detector_index", "crop_path", "text", "detection_confidence", "recognition_confidence", "region_quad", "page_quad"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "region_id": {"type": "string", "minLength": 1},
        "detector_index": {"type": "integer", "minimum": 0},
        "crop_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/repository_path"}]},
        "text": {"type": ["string", "null"]},
        "detection_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "recognition_confidence": {"$ref": "#/$defs/confidence"},
        "region_quad": {"$ref": "#/$defs/quad"},
        "page_quad": {"$ref": "#/$defs/quad"}
      },
      "allOf": [
        {
          "if": {"properties": {"text": {"type": "null"}}},
          "then": {"properties": {"recognition_confidence": {"type": "null"}}},
          "else": {"properties": {"recognition_confidence": {"type": "number"}}}
        }
      ]
    },
    "ocr_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "content", "region_bbox", "page_bbox"],
      "properties": {
        "label": {"type": "string"},
        "content": {"type": "string"},
        "region_bbox": {"$ref": "#/$defs/bbox"},
        "page_bbox": {"$ref": "#/$defs/bbox"}
      }
    }
  }
}
