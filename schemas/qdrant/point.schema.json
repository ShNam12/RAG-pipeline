{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qdrant point with a dense embedding",
  "description": "An upload point requires a real vector whose length and name match the chosen collection configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "vector", "payload"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "vector": {
      "oneOf": [
        {"$ref": "#/$defs/dense_vector"},
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/dense_vector"}
        }
      ]
    },
    "payload": {"$ref": "payload.schema.json"}
  },
  "$defs": {
    "id": {"type": "string", "format": "uuid"},
    "dense_vector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "staged_point": {
      "description": "A local fixture point awaiting embedding generation before it can become an upload point.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "payload"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "payload": {"$ref": "payload.schema.json"}
      }
    }
  }
}
