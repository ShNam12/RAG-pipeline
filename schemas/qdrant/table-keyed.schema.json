{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Header-keyed extracted table payload",
  "description": "One extracted table with OCR-aligned header keys and one key-value map per data row.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "source", "ocr_path", "table_artifact", "table_artifact_sha256", "table_id", "page_number", "bbox", "extraction_status", "method", "column_count", "header_mapping", "raw_header_cell", "headers", "records"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "record_type": {"const": "table"},
    "source": {"type": "string", "minLength": 1},
    "ocr_path": {"type": "string", "minLength": 1},
    "table_artifact": {"type": "string", "minLength": 1},
    "table_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "table_id": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 1},
    "bbox": {"$ref": "table.schema.json#/$defs/bbox"},
    "extraction_status": {"enum": ["complete", "partial"]},
    "method": {"type": "string", "minLength": 1},
    "column_count": {"type": "integer", "minimum": 1},
    "header_mapping": {"const": "ocr_aligned"},
    "raw_header_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "column_index", "rowspan", "colspan", "ocr_refs"],
      "properties": {
        "text": {"type": "string"},
        "column_index": {"type": "integer", "minimum": 0},
        "rowspan": {"type": "integer", "minimum": 1},
        "colspan": {"type": "integer", "minimum": 1},
        "ocr_refs": {"$ref": "#/$defs/ocr_refs"}
      }
    },
    "headers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column_index", "ocr_line_id"],
        "properties": {
          "column_index": {"type": "integer", "minimum": 0},
          "ocr_line_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_index", "values", "cell_ocr_refs"],
        "properties": {
          "row_index": {"type": "integer", "minimum": 1},
          "values": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"minLength": 1},
            "additionalProperties": {"type": ["string", "null"]}
          },
          "cell_ocr_refs": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"minLength": 1},
            "additionalProperties": {"$ref": "#/$defs/ocr_refs"}
          }
        }
      }
    }
  },
  "$defs": {
    "ocr_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
