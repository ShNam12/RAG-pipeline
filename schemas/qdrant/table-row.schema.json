{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Searchable header-keyed table row payload",
  "description": "Target retrieval payload for one data row linked to a header-keyed table point.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "ocr_path", "table_artifact", "table_artifact_sha256", "table_point_id", "table_id", "page_number", "row_index", "header_mapping", "values", "cell_ocr_refs", "embedding_model", "embedding_text"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "record_type": {"const": "table_row"},
    "ocr_path": {"type": "string", "minLength": 1},
    "table_artifact": {"type": "string", "minLength": 1},
    "table_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "table_point_id": {"type": "string", "format": "uuid"},
    "table_id": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 1},
    "row_index": {"type": "integer", "minimum": 1},
    "header_mapping": {"const": "ocr_aligned"},
    "values": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": ["string", "null"]}
    },
    "cell_ocr_refs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "table-keyed.schema.json#/$defs/ocr_refs"}
    },
    "embedding_model": {"const": "thanhtantran/Vietnamese_Embedding"},
    "embedding_text": {"type": "string", "minLength": 1}
  }
}
